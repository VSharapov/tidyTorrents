# gluetun settings for qbt-vpn. Copy to .env (gitignored) and swap in a real VPN when you have one.
#
# Default: an obviously fake WireGuard peer. gluetun starts, the handshake never completes,
# and qbt-vpn stays offline (fail closed). Your linux rivals at the ISP learn nothing either way.
VPN_SERVICE_PROVIDER=custom
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=thisKeyBase64IsObviouslyFakeAAAAAAAAAAAAAAA=
WIREGUARD_PUBLIC_KEY=thisKeyBase64IsObviouslyFakeBBBBBBBBBBBBBBB=
WIREGUARD_ADDRESSES=10.69.69.2/32
VPN_ENDPOINT_IP=69.69.69.69
VPN_ENDPOINT_PORT=51820

# Real, free, P2P allowed (10 GB/month): PrivadoVPN over OpenVPN
# VPN_SERVICE_PROVIDER=privado
# OPENVPN_USER=
# OPENVPN_PASSWORD=
