# tidyTorrents config. Copy to .env (gitignored) and edit. Unset values use the defaults shown.

# Where torrents live. Default: ./my-beloved-linux-iso-collection (from wherever you run compose).
# IRL, point it at the NAS. Must be ABSOLUTE: it's mounted at the same path in every container,
# so absolute symlinks into it resolve everywhere.
#TT_STORAGE=/mnt/nas/torrents

# VPN for qbt-vpn:
#   warp (default): Cloudflare WARP, registered anonymously on first start. No signup, no cap.
#     Cloudflare keeps logs and says WARP "is not designed to hide your identity". This is fine:
#     this repo is for educational purposes only and legally downloads Linux ISOs, so we have
#     nothing to fear. Nothing at all.
#   fake: an obviously fake WireGuard peer (69.69.69.69). qbt-vpn stays offline (fail closed).
#TT_VPN=warp

# Real, P2P allowed, 10 GB/month, needs signup: PrivadoVPN over OpenVPN (overrides TT_VPN)
#VPN_SERVICE_PROVIDER=privado
#VPN_TYPE=openvpn
#OPENVPN_USER=
#OPENVPN_PASSWORD=
